@startuml Diagram_2_2_Builder_Observer
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 40
skinparam ArrowSize 1
skinparam defaultFontSize 11
skinparam classFontSize 11
skinparam classAttributeFontSize 10
skinparam shadowing false
skinparam linetype ortho

hide empty members
hide circle

title Section 2.2 — Builder Pattern & Observer Pattern

' ============================================================
' PACKAGE: com.rental.model
' ============================================================
package "com.rental.model" {
    class Customer {
        - name : String
        + Customer(name : String)
        + getName() : String
        + toString() : String
    }

    class RentalAgreement {
        - customer : Customer
        - vehicle : Vehicle
        - hours : int
        - extras : String
        - totalCost : double
        + RentalAgreement(customer : Customer, vehicle : Vehicle, hours : int, extras : String, totalCost : double)
        + getCustomer() : Customer
        + getVehicle() : Vehicle
        + getHours() : int
        + getExtras() : String
        + getTotalCost() : double
        + toString() : String
    }

    interface Vehicle {
        + getId() : String
        + getType() : String
        + getBasePricePerHour() : double
        + isAvailable() : boolean
        + setAvailable(available : boolean) : void
    }
}

' ============================================================
' PACKAGE: com.rental.observer
' ============================================================
package "com.rental.observer" {
    interface AvailabilityObserver {
        + update(vehicle : Vehicle, isAvailable : boolean) : void
    }

    class AvailabilitySubject {
        - observers : List<AvailabilityObserver>
        + attach(observer : AvailabilityObserver) : void
        + notifyObservers(vehicle : Vehicle, isAvailable : boolean) : void
    }

    class CustomerNotifier {
        + update(vehicle : Vehicle, isAvailable : boolean) : void
    }
}

' ============================================================
' PACKAGE: com.rental.builder
' ============================================================
package "com.rental.builder" {
    class RentalAgreementBuilder {
        - customer : Customer
        - vehicle : Vehicle
        - hours : int
        - strategy : PricingStrategy
        - rentalService : RentalService
        + setCustomer(customer : Customer) : RentalAgreementBuilder
        + setVehicle(vehicle : Vehicle) : RentalAgreementBuilder
        + setHours(hours : int) : RentalAgreementBuilder
        + setStrategy(strategy : PricingStrategy) : RentalAgreementBuilder
        + addExtra(extra : String) : RentalAgreementBuilder
        + build() : RentalAgreement
    }
}

' ============================================================
' PACKAGE: com.rental.strategy  (interface only — builder depends on it)
' ============================================================
package "com.rental.strategy" {
    interface PricingStrategy {
        + calculatePrice(vehicle : Vehicle, hours : int) : double
        + getStrategyName() : String
    }
}

' ============================================================
' PACKAGE: com.rental.decorator  (builder creates these classes)
' ============================================================
package "com.rental.decorator" {
    interface RentalService {
        + getCost() : double
        + getDescription() : String
    }

    class BaseRental {
        - vehicle : Vehicle
        - hours : int
        - strategy : PricingStrategy
        + BaseRental(vehicle : Vehicle, hours : int, strategy : PricingStrategy)
        + getCost() : double
        + getDescription() : String
    }

    class GPSDecorator {
        + GPSDecorator(decoratedService : RentalService)
        + getCost() : double
        + getDescription() : String
    }

    class ChildSeatDecorator {
        + ChildSeatDecorator(decoratedService : RentalService)
        + getCost() : double
        + getDescription() : String
    }

    class FullInsuranceDecorator {
        + FullInsuranceDecorator(decoratedService : RentalService)
        + getCost() : double
        + getDescription() : String
    }
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' --- Realization ---
AvailabilityObserver <|.. CustomerNotifier

' --- Composition (RentalAgreement owns its Customer and Vehicle) ---
AvailabilitySubject "1" o-- "*" AvailabilityObserver : notifies >

RentalAgreement "1" *-- "1" Customer : has >
RentalAgreement "1" *-- "1" Vehicle : has >

' --- Dependencies ---
RentalAgreementBuilder ..> RentalAgreement : creates >
RentalAgreementBuilder ..> Customer : uses >
RentalAgreementBuilder ..> Vehicle : uses >
RentalAgreementBuilder ..> PricingStrategy : uses >
RentalAgreementBuilder ..> RentalService : uses >
RentalAgreementBuilder ..> BaseRental : creates >
RentalAgreementBuilder ..> GPSDecorator : creates >
RentalAgreementBuilder ..> ChildSeatDecorator : creates >
RentalAgreementBuilder ..> FullInsuranceDecorator : creates >

@enduml