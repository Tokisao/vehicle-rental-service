@startuml Diagram_Final
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' Force vertical stacking of packages
skinparam nodesep 30
skinparam ranksep 40
skinparam ArrowSize 1
skinparam defaultFontSize 11
skinparam classFontSize 11
skinparam classAttributeFontSize 10

' Render as a single column
skinparam componentStyle rectangle
skinparam packageStyle rectangle

hide empty members
hide circle
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' ============================================================
' PACKAGE: com.rental (Main application)
' ============================================================
package "com.rental" {
    class RentalApp {
        - {static} scanner : Scanner
        - {static} availableVehicles : Map<String, Vehicle>
        - {static} rentalHistory : List<RentalAgreement>
        - {static} facade : RentalFacade
        - {static} agreementCounter : int
        + {static} main(args : String[]) : void
        - {static} printMainMenu() : void
        - {static} showAvailableVehicles() : void
        - {static} rentVehicle() : void
        - {static} returnVehicle() : void
        - {static} showRentalHistory() : void
        - {static} calculatePricePreview() : void
        - {static} readInt(prompt : String) : int
    }
}

' ============================================================
' PACKAGE: com.rental.model
' ============================================================
package "com.rental.model" {
    interface Vehicle {
        + getId() : String
        + getType() : String
        + getBasePricePerHour() : double
        + isAvailable() : boolean
        + setAvailable(available : boolean) : void
    }

    class Car {
        - id : String
        - available : boolean
        + Car(id : String)
        + getId() : String
        + getType() : String
        + getBasePricePerHour() : double
        + isAvailable() : boolean
        + setAvailable(available : boolean) : void
    }

    class Bike {
        - id : String
        - available : boolean
        + Bike(id : String)
        + getId() : String
        + getType() : String
        + getBasePricePerHour() : double
        + isAvailable() : boolean
        + setAvailable(available : boolean) : void
    }

    class ElectricScooter {
        - id : String
        - available : boolean
        + ElectricScooter(id : String)
        + getId() : String
        + getType() : String
        + getBasePricePerHour() : double
        + isAvailable() : boolean
        + setAvailable(available : boolean) : void
    }

    class Customer {
        - name : String
        + Customer(name : String)
        + getName() : String
        + toString() : String
    }

    class RentalAgreement {
        - customer : Customer
        - vehicle : Vehicle
        - hours : int
        - extras : String
        - totalCost : double
        + RentalAgreement(customer : Customer, vehicle : Vehicle, hours : int, extras : String, totalCost : double)
        + getCustomer() : Customer
        + getVehicle() : Vehicle
        + getHours() : int
        + getExtras() : String
        + getTotalCost() : double
        + toString() : String
    }
}

' ============================================================
' PACKAGE: com.rental.factory
' ============================================================
package "com.rental.factory" {
    class VehicleFactory {
        + {static} createVehicle(type : String, id : String) : Vehicle
    }
}

' ============================================================
' PACKAGE: com.rental.strategy
' ============================================================
package "com.rental.strategy" {
    interface PricingStrategy {
        + calculatePrice(vehicle : Vehicle, hours : int) : double
        + getStrategyName() : String
    }

    class HourlyPricing {
        + calculatePrice(vehicle : Vehicle, hours : int) : double
        + getStrategyName() : String
    }

    class DailyPricing {
        + calculatePrice(vehicle : Vehicle, hours : int) : double
        + getStrategyName() : String
    }

    class WeekendPricing {
        + calculatePrice(vehicle : Vehicle, hours : int) : double
        + getStrategyName() : String
    }
}

' ============================================================
' PACKAGE: com.rental.observer
' ============================================================
package "com.rental.observer" {
    interface AvailabilityObserver {
        + update(vehicle : Vehicle, isAvailable : boolean) : void
    }

    class AvailabilitySubject {
        - observers : List<AvailabilityObserver>
        + attach(observer : AvailabilityObserver) : void
        + notifyObservers(vehicle : Vehicle, isAvailable : boolean) : void
    }

    class CustomerNotifier {
        + update(vehicle : Vehicle, isAvailable : boolean) : void
    }
}

' ============================================================
' PACKAGE: com.rental.decorator  (NEW)
' ============================================================
package "com.rental.decorator" {
    interface RentalService {
        + getCost() : double
        + getDescription() : String
    }

    class BaseRental {
        - vehicle : Vehicle
        - hours : int
        - strategy : PricingStrategy
        + BaseRental(vehicle : Vehicle, hours : int, strategy : PricingStrategy)
        + getCost() : double
        + getDescription() : String
    }

    abstract class RentalDecorator {
        # decoratedService : RentalService
        + RentalDecorator(decoratedService : RentalService)
        + getCost() : double
        + getDescription() : String
    }

    class GPSDecorator {
        + GPSDecorator(decoratedService : RentalService)
        + getCost() : double
        + getDescription() : String
    }

    class ChildSeatDecorator {
        + ChildSeatDecorator(decoratedService : RentalService)
        + getCost() : double
        + getDescription() : String
    }

    class FullInsuranceDecorator {
        + FullInsuranceDecorator(decoratedService : RentalService)
        + getCost() : double
        + getDescription() : String
    }
}

' ============================================================
' PACKAGE: com.rental.builder
' ============================================================
package "com.rental.builder" {
    class RentalAgreementBuilder {
        - customer : Customer
        - vehicle : Vehicle
        - hours : int
        - strategy : PricingStrategy
        - rentalService : RentalService
        + setCustomer(customer : Customer) : RentalAgreementBuilder
        + setVehicle(vehicle : Vehicle) : RentalAgreementBuilder
        + setHours(hours : int) : RentalAgreementBuilder
        + setStrategy(strategy : PricingStrategy) : RentalAgreementBuilder
        + addExtra(extra : String) : RentalAgreementBuilder
        + build() : RentalAgreement
    }
}

' ============================================================
' PACKAGE: com.rental.facade
' ============================================================
package "com.rental.facade" {
    class RentalFacade {
        - availabilitySubject : AvailabilitySubject
        + RentalFacade()
        + findVehicle(type : String, id : String) : Vehicle
        + createAgreement(customer : Customer, vehicle : Vehicle, hours : int, pricingType : String, extras : String[]) : RentalAgreement
        + payAndRent(agreement : RentalAgreement) : void
        + returnVehicle(agreement : RentalAgreement) : void
    }
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' --- Inheritance (Realization) ---
Vehicle <|.. Car
Vehicle <|.. Bike
Vehicle <|.. ElectricScooter

PricingStrategy <|.. HourlyPricing
PricingStrategy <|.. DailyPricing
PricingStrategy <|.. WeekendPricing

AvailabilityObserver <|.. CustomerNotifier

RentalService <|.. BaseRental
RentalService <|.. RentalDecorator
RentalDecorator <|-- GPSDecorator
RentalDecorator <|-- ChildSeatDecorator
RentalDecorator <|-- FullInsuranceDecorator

' --- Composition / Aggregation ---
RentalAgreement *-- Customer : has >
RentalAgreement *-- Vehicle : has >

AvailabilitySubject o-- AvailabilityObserver : notifies >

RentalDecorator o-- RentalService : decorates >

' --- Dependencies ---
RentalApp ..> RentalFacade : uses >
RentalApp ..> VehicleFactory : uses >
RentalApp ..> Vehicle : uses >
RentalApp ..> Customer : uses >
RentalApp ..> RentalAgreement : uses >
RentalApp ..> PricingStrategy : uses >

RentalFacade ..> VehicleFactory : uses >
RentalFacade ..> RentalAgreementBuilder : uses >
RentalFacade ..> PricingStrategy : uses >
RentalFacade ..> AvailabilitySubject : uses >
RentalFacade ..> CustomerNotifier : creates >

RentalAgreementBuilder ..> RentalAgreement : creates >
RentalAgreementBuilder ..> RentalService : uses >
RentalAgreementBuilder ..> BaseRental : creates >
RentalAgreementBuilder ..> GPSDecorator : creates >
RentalAgreementBuilder ..> ChildSeatDecorator : creates >
RentalAgreementBuilder ..> FullInsuranceDecorator : creates >
RentalAgreementBuilder ..> PricingStrategy : uses >
RentalAgreementBuilder ..> Vehicle : uses >
RentalAgreementBuilder ..> Customer : uses >

VehicleFactory ..> Vehicle : creates >
VehicleFactory ..> Car : creates >
VehicleFactory ..> Bike : creates >
VehicleFactory ..> ElectricScooter : creates >

HourlyPricing ..> Vehicle : uses >
DailyPricing ..> Vehicle : uses >
WeekendPricing ..> Vehicle : uses >

BaseRental ..> Vehicle : uses >
BaseRental ..> PricingStrategy : uses >

@enduml